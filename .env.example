# Local settings for running the API. Copy this file to .env (gitignored) and fill in the values.
# The API never reads this file: VS Code (launch.json "envFile") and docker compose load it into environment
# variables, which the API reads. Non-secret defaults live in backend/src/WebAPI/appsettings.json.
# Quote any value that contains ";", such as the connection string. See docs/operations.md, Configuration.

# The password docker compose gives the local database (docker-compose.yml)
POSTGRES_PASSWORD=

# The API's database: the compose database above, so its Password must be the same as POSTGRES_PASSWORD
ConnectionStrings__Default="Host=localhost;Port=5433;Database=solaris;Username=postgres;Password="

# At least 32 characters, for example the output of: openssl rand -base64 48
Jwt__Secret=

# The Gmail address the API sends from (sales notifications are sent to it too)
Email__FromAddress=

# The Gmail OAuth client the SMTP login uses
Email__Gmail__ClientId=
Email__Gmail__ClientSecret=
Email__Gmail__RefreshToken=
