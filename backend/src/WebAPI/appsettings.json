{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "solaris-api",
    "Audience": "solaris-staff"
  },
  "Email": {
    "FromName": "Solaris",
    "Smtp": {
      "Host": "smtp.gmail.com",
      "Port": 587
    }
  }
}

